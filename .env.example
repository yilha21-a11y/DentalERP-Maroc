# =============================================================
# DentalERP Maroc Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# ── Database (MySQL) ──────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/dental_erp"

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── File Storage ──────────────────────────────────────────────
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# ── Object Storage (S3-compatible) — Optional ─────────────────
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="dentalerp"
# S3_SECRET_KEY="dentalerp123"
# S3_BUCKET="dental-erp-uploads"
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="true"

# ── Cache / Queue (Redis) — Optional ──────────────────────────
# REDIS_URL="redis://localhost:6379"

# ── Application ───────────────────────────────────────────────
NODE_ENV="development"

# ── Payment Gateway Encryption ────────────────────────────────
# Required only when legacy encrypted online gateways are enabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Cron Jobs Security (REQUIRED for automations) ─────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""

# ── WhatsApp Business Cloud API ───────────────────────────────
# Official Meta WhatsApp Business Platform credentials.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Keep configurable so Meta Graph API upgrades do not require code changes.
WHATSAPP_GRAPH_VERSION="v23.0"
# Approved template names in Meta Business Manager.
WHATSAPP_TEMPLATE_REMINDER_24H="rendez_vous_24h"
WHATSAPP_TEMPLATE_REMINDER_2H="rendez_vous_2h"
WHATSAPP_TEMPLATE_GOOGLE_REVIEW="avis_google"
# Direct Google review link for the clinic.
GOOGLE_REVIEW_URL=""

# ── Waiting-room TV display ───────────────────────────────────
# The kiosk URL is:
#   /waiting-room-display?token=<WAITING_ROOM_DISPLAY_TOKEN>
# Generate a long random token and never show it on the public TV screen.
WAITING_ROOM_DISPLAY_TOKEN=""
# Hospital/clinic id whose queue is displayed by this installation.
WAITING_ROOM_HOSPITAL_ID=""

# ── AI (OpenRouter) — Optional ────────────────────────────────
OPENROUTER_API_KEY=""

# ── Email (SMTP) — Optional ──────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

# ── SMS Gateway — Optional fallback ──────────────────────────
SMS_API_KEY=""
SMS_SENDER_ID="DENTAL"

# ── Video Consultation — Optional ─────────────────────────────
JITSI_DOMAIN="meet.jit.si"
# DAILY_API_KEY=""
# DAILY_DOMAIN="your-domain.daily.co"
